rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 2026년 제3차 경기도 환경교육 관계자 워크숍 만족도 조사
    match /gg-env-workshop-2026-3/{id} {

      // 누구나 응답 제출 가능 (형식 검사 통과 시)
      allow create: if validResponse(request.resource.data);

      // 결과 열람은 관리자 이메일로 로그인한 경우만
      // ▼ 'ADMIN_EMAIL@example.com' 을 Authentication에 만든 관리자 이메일로 바꿔 주세요.
      allow read: if request.auth != null
                  && request.auth.token.email in ['ADMIN_EMAIL@example.com'];

      // 제출된 응답은 수정·삭제 불가
      allow update, delete: if false;
    }

    function score(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function validResponse(d) {
      return d.keys().hasOnly(['q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11','org','programs','createdAt'])
        && score(d.q1) && score(d.q2) && score(d.q3) && score(d.q4) && score(d.q5)
        && score(d.q6) && score(d.q7) && score(d.q8) && score(d.q9) && score(d.q10)
        && d.q11 is string && d.q11.size() <= 1000
        && d.org is string && d.org.size() <= 50
        && d.programs is list && d.programs.size() <= 10
        && d.createdAt == request.time;
    }
  }
}
